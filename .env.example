# Vision Mysuru 2050 - Registration Desk & E-Pass Platform
# Environment Configuration Template

# Email Service (Gmail SMTP / Custom Transactional SMTP)
# For Gmail, create an App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=visionmysuru2050@gmail.com
EMAIL_PASS=your-google-app-password
EMAIL_SERVICE=gmail

# Optional: Resend API Key (alternative for Vercel)
# RESEND_API_KEY=re_123456789

# Optional: Production deployment URL
NEXT_PUBLIC_APP_URL=https://vision-mysuru-registration-desk.vercel.app

# Optional: Database URL for persistent PostgreSQL / Neon on Vercel
# If omitted, platform runs with resilient JSON file persistence locally and memory cache on serverless
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
